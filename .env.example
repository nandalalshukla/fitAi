# ============================================================================================
# FormFit environment variables (template — committed, contains NO real values)
#
#   cp .env.example .env      # local development (.env is gitignored)
#
# Two kinds of values:
#   [PUBLIC]  EXPO_PUBLIC_*  → inlined into the JS bundle; anyone with the app can read them.
#                              Only publishable identifiers/keys belong here.
#   [SECRET]  everything else → read at build time by app.config.ts, EAS or tooling, or entered
#                              in a dashboard. NEVER bundled into the app. In CI/EAS store them as
#                              secrets (`eas env:create --visibility secret`), not in files.
# Every value is optional: without it the related feature is simply disabled.
# Step-by-step instructions for each value: docs/ENVIRONMENT.md
# ============================================================================================

# --- Backend: Supabase ----------------------------------------------------------------------
# [PUBLIC] Project URL. Supabase dashboard → Project Settings → API → Project URL (https://….supabase.co)
EXPO_PUBLIC_SUPABASE_URL=
# [PUBLIC] anon / publishable key. Same page → Project API keys → anon public. Safe to ship (RLS).
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# [SECRET] Project ref (the subdomain of the URL), used by `npx supabase link`.
SUPABASE_PROJECT_ID=
# [SECRET] Personal access token for the Supabase CLI (account → Access Tokens). CI / migrations only.
SUPABASE_ACCESS_TOKEN=

# --- Sign in with Google --------------------------------------------------------------------
# [PUBLIC] OAuth *Web* client ID (Google Cloud Console → APIs & Services → Credentials). Supabase
#          verifies Google id tokens against it. Leave blank to hide the Google button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# [PUBLIC] OAuth *iOS* client ID (same page, type iOS, bundle id com.formfit.app).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# [SECRET] Reversed iOS client ID, e.g. com.googleusercontent.apps.1234-abcd (iOS URL scheme).
GOOGLE_IOS_URL_SCHEME=
# [SECRET] Web client ID + secret, entered in Supabase → Authentication → Providers → Google
#          (also read by backend/supabase/config.toml for the local stack).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# --- Sign in with Apple ---------------------------------------------------------------------
# Native iOS sign-in needs no app secret: enable "Sign in with Apple" on the App ID and add the
# bundle id to Supabase → Auth → Providers → Apple → Authorized Client IDs.
# [SECRET] Only for web/Android Apple sign-in via Supabase: Services ID and generated client secret JWT.
APPLE_SERVICES_ID=
APPLE_SIGNIN_SECRET=
# [SECRET] Apple Developer Team ID (developer.apple.com → Membership). Used by EAS submit/credentials.
APPLE_TEAM_ID=

# --- Crash reporting: Sentry ----------------------------------------------------------------
# [PUBLIC] DSN. Sentry → Settings → Projects → formfit → Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=
# [SECRET] For source-map upload at build time: org slug, project slug, auth token
#          (Sentry → Settings → Auth Tokens, scope project:releases). Token = EAS secret only.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Analytics: PostHog-compatible (optional) ----------------------------------------------
# [PUBLIC] Project API key (phc_…) and ingestion host (e.g. https://eu.i.posthog.com).
EXPO_PUBLIC_ANALYTICS_KEY=
EXPO_PUBLIC_ANALYTICS_HOST=

# --- App info & legal -----------------------------------------------------------------------
# [PUBLIC] Support email shown under Settings → Help & feedback.
EXPO_PUBLIC_SUPPORT_EMAIL=
# [PUBLIC] Hosted privacy policy and terms (https). Required by the App Store and Google Play.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

# --- Build: Expo / EAS ----------------------------------------------------------------------
# [SECRET] Build variant: development | preview | production (EAS profiles set this themselves).
APP_VARIANT=development
# [SECRET] Base bundle identifier / Android package. Dev & preview builds append .dev / .preview.
APP_BUNDLE_ID=com.formfit.app
# [SECRET] EAS project ID (expo.dev → project → Project ID, or `eas init`).
EAS_PROJECT_ID=
# [SECRET] Expo access token for CI (expo.dev → Account settings → Access tokens). GitHub secret only.
EXPO_TOKEN=
