# FormFit environment variables.
# Copy to `.env` (gitignored) for local development. In CI/EAS use secrets/env vars instead.
#
# PUBLIC (client-side): `EXPO_PUBLIC_*` values are inlined into the JS bundle and visible to
# anyone with the app. Only put publishable keys here.
# SECRET (build-time only): everything else is read by app.config.ts / tooling and is NEVER
# bundled into the app.
#
# The full list (Supabase, Sentry, analytics, Google/Apple sign-in) is completed in the final
# environment step; variables introduced so far:

# --- Public ---
# Supabase project URL (Supabase dashboard -> Project Settings -> API).
EXPO_PUBLIC_SUPABASE_URL=
# Supabase anon (publishable) key. Safe to ship: Row Level Security protects data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Google Sign-In OAuth client IDs (Google Cloud Console -> APIs & Services -> Credentials).
# The *web* client ID is what Supabase verifies id tokens against. Leave blank to hide Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Support address shown under Settings -> Help & feedback (public). Leave blank to hide.
EXPO_PUBLIC_SUPPORT_EMAIL=
# Hosted privacy policy and terms (required by the App Store / Play). https:// URLs.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
# Sentry DSN for crash reporting (Sentry -> Project Settings -> Client Keys).
EXPO_PUBLIC_SENTRY_DSN=
# Analytics project key + host (e.g. PostHog). Leave blank to disable analytics.
EXPO_PUBLIC_ANALYTICS_KEY=
EXPO_PUBLIC_ANALYTICS_HOST=

# --- Secret / build-time ---
# Build variant: development | preview | production (set per EAS profile in eas.json).
APP_VARIANT=development
# Base bundle identifier / Android package. Dev & preview builds append .dev / .preview.
APP_BUNDLE_ID=com.formfit.app
# EAS project ID (expo.dev -> project -> ID). Needed for EAS Build/Update.
EAS_PROJECT_ID=
# Reversed iOS client ID, e.g. com.googleusercontent.apps.1234-abcd (adds the Google Sign-In
# URL scheme to the iOS build). Leave blank to build without Google Sign-In on iOS.
GOOGLE_IOS_URL_SCHEME=

# Sentry source-map upload (build time only). SENTRY_AUTH_TOKEN must be an EAS secret.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Supabase backend (Supabase CLI / dashboard only, never bundled) ---
# Project ref (the subdomain of EXPO_PUBLIC_SUPABASE_URL), used by `supabase link`.
SUPABASE_PROJECT_ID=
# Referenced by backend/supabase/config.toml for local auth providers.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
APPLE_SERVICES_ID=
APPLE_SIGNIN_SECRET=
