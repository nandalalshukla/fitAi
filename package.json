    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "react-server-dom-webpack": "^19.3.0",
    "sql.js": "^1.15.1",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest && npm run test:db",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "maestro test e2e",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "db:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > src/data/supabase/database.types.ts",
    "doctor": "npx expo-doctor@latest",
    "prepare": "husky",
    "models:fetch": "node scripts/fetch-models.mjs",
    "fixtures:generate": "GENERATE_FIXTURES=1 jest src/features/exercises/replay/generateFixtures",
    "test:unit": "jest",
    "test:db": "node --experimental-strip-types --no-warnings --test backend/supabase/tests/rls.test.mts"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
